# Copy to .env.local. Nothing here is required to run the local demo.

# Supabase (see docs/SUPABASE-SETUP.md). When these are set, the app stores everything in
# Supabase and people sign in with mobile number + PIN. When they're not, it uses a local file
# and the pick-your-name demo sign-in.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Turns 5-digit PINs into passwords. 32+ random characters; never change it once people have PINs.
PIN_SECRET=

# Ticket reading. Without a key, drivers type the fields in from the photo.
# Gemini (free tier, https://aistudio.google.com/apikey). On the free tier Google may use what is
# sent to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest   (free tier: 500/day; gemini-flash-latest is only 20/day)
# Or Claude (paid): ANTHROPIC_API_KEY=  CLAUDE_MODEL=claude-opus-5  TICKET_READER_EFFORT=medium
# Force a reader: TICKET_READER=gemini | claude | none (none = drivers type every ticket in)

# Local demo only: signs the session cookie. Required (32+ characters) for a production build
# without Supabase.
SESSION_SECRET=
# Allow the pick-your-name demo sign-in on a production build without Supabase.
# DEMO_SIGN_IN=1
# Where the local store keeps db.json and photos (default: ./.data)
# DATA_DIR=
