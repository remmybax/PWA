# Copy to .env.local. Nothing here is needed to run the local demo.

# Supabase (see docs/SUPABASE-SETUP.md). Use a NEW Supabase project, not the Ticket Log's.
# When these are set, everything is stored in Supabase and people sign in with mobile number + PIN.
# When they're not, the app uses a local file (.data/) and a pick-your-name demo sign-in.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Turns 5-digit PINs into passwords. 32+ random characters; never change it once people have PINs.
PIN_SECRET=

# The address the QR codes point to once the app is online, e.g. https://inspect.example.com
# Without it, QR codes use whatever address the page was opened on (fine on the PC's Wi-Fi).
PUBLIC_BASE_URL=

# The Ticket Log app's address. Makes "Ticket upload" on the driver home screen open it.
TICKET_LOG_URL=

# Local demo only: signs the session cookie. Required (32+ characters) for a production build
# without Supabase.
SESSION_SECRET=
# Allow the pick-your-name demo sign-in on a production build without Supabase.
# DEMO_SIGN_IN=1
# Where the local store keeps db.json and photos (default: ./.data)
# DATA_DIR=
